---
import Footer from '~/components/Footer.astro';
import MainHead from '~/components/MainHead.astro';
import Nav from '~/components/Nav.astro';
import { defaultLocale, type Locale } from '~/i18n/ui';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	lang?: Locale | undefined;
	/** This page's URL in every locale. Providing it shows the language switcher. */
	alternates?: Record<Locale, string> | undefined;
}

const { title, description, lang = defaultLocale, alternates } = Astro.props;
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} lang={lang} />
	</head>
	<body>
		<div class="flex flex-col min-h-dvh">
			<Nav lang={lang} alternates={alternates} />
			<slot />
			<Footer />
		</div>
	</body>
</html>
