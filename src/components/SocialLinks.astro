---
import Icon from "./Icon.astro";
import { socialLinks } from "~/socials";

interface Props {
  /**
   * - `plain`: bare icons, sized by `--icon-size` and padded by `--icon-padding` (set on
   *   the nav's menu footer, so they stay in step with the language switcher beside them).
   * - `pill`: yellow round buttons, for the "follow" rows on the Trainings and Contacts pages.
   */
  variant: "plain" | "pill";
}

const { variant } = Astro.props;

const variants = {
  plain: {
    list: "flex flex-wrap gap-2 text-[length:var(--icon-size,1.5rem)]",
    link:
      "flex p-[var(--icon-padding,0.5rem)] text-gray-700 no-underline transition-colors " +
      "hover:text-green-800 active:text-green-500",
    iconSize: undefined,
  },
  pill: {
    list: "flex gap-2",
    link:
      "flex size-10 items-center justify-center rounded-full bg-yellow-500 text-gray-700 no-underline shadow-md " +
      "transition hover:bg-yellow-700 hover:shadow-lg",
    iconSize: "1.15rem",
  },
}[variant];
---

<ul class={variants.list}>
  {
    socialLinks.map(({ href, icon, label }) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class={variants.link}
        >
          <span class="sr-only">{label}</span>
          <Icon icon={icon} size={variants.iconSize} />
        </a>
      </li>
    ))
  }
</ul>
