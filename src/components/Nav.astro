---
import { ui, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
	/** Locale of the page this nav is rendered on. */
	lang: Locale;
	/** This page's URL in every locale. Omitted on pages that aren't translated yet. */
	alternates?: Record<Locale, string> | undefined;
}

const { lang, alternates } = Astro.props;

/** Main menu items. Only Experience and Blog are translated so far — the rest follow once their pages are. */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work/' },
	{ label: 'About', href: '/about/' },
	{ label: ui[lang]['nav.experience'], href: localizedPath('experience', lang) },
	{ label: ui[lang]['nav.blog'], href: localizedPath('blog', lang) },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'Twitter', href: 'https://twitter.com/me', icon: 'twitter-logo' },
	{ label: 'Twitch', href: 'https://twitch.tv/me', icon: 'twitch-logo' },
	{ label: 'GitHub', href: 'https://github.com/me', icon: 'github-logo' },
	{ label: 'CodePen', href: 'https://codepen.io/me', icon: 'codepen-logo' },
	{ label: 'dribbble', href: 'https://dribbble.com/me', icon: 'dribbble-logo' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@me/', icon: 'youtube-logo' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};

const navItemsClass =
	'nav-items m-0 flex flex-col gap-4 list-none p-8 text-md leading-[1.2] bg-gray-999 border-b border-gray-800 ' +
	'lg:relative lg:flex-row lg:border-0 lg:rounded-full lg:py-2 lg:px-2.25 lg:text-sm lg:shadow-md ' +
	'lg:bg-[image:radial-gradient(var(--gray-900),var(--gray-800)_150%)] ' +
	"lg:before:absolute lg:before:-inset-px lg:before:-z-[1] lg:before:content-[''] lg:before:rounded-full lg:before:bg-[image:var(--gradient-stroke)]";

const linkClass =
	'link inline-block text-gray-300 no-underline aria-[current=page]:text-gray-0 ' +
	'lg:px-4 lg:py-2 lg:rounded-full lg:transition-colors lg:duration-200 lg:ease-in-out ' +
	'lg:hover:text-gray-100 lg:hover:bg-accent-subtle-overlay lg:focus:text-gray-100 lg:focus:bg-accent-subtle-overlay ' +
	'lg:aria-[current=page]:bg-accent-regular lg:aria-[current=page]:text-accent-text-over ' +
	'aria-[current=page]:forced-colors:text-[SelectedItem]';

const menuFooterClass =
	'menu-footer [--icon-size:var(--text-xl)] [--icon-padding:0.5rem] flex justify-between gap-3 py-6 pl-6 pr-8 ' +
	'bg-gray-999 rounded-b-xl shadow-lg ' +
	'lg:[--icon-padding:0.375rem] lg:justify-self-end lg:items-center lg:p-0 lg:bg-transparent lg:shadow-none';

const socialsClass = 'socials flex flex-wrap gap-2.5 text-[length:var(--icon-size)] lg:hidden xl:flex xl:justify-end xl:gap-0';

const socialClass =
	'social flex p-[var(--icon-padding)] no-underline text-accent-dark transition-colors duration-200 ease-in-out ' +
	'hover:text-accent-text-over focus:text-accent-text-over';
---

<nav class="relative z-[9999] font-brand font-medium mb-14 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:py-10 lg:px-20 lg:gap-4">
	<div class="menu-header flex justify-between gap-2 p-6 lg:p-0">
		<a href="/" class="site-title flex items-center gap-2 leading-[1.1] text-gray-0 no-underline lg:text-lg">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
			Jeanine White
		</a>
		<menu-button>
			<template>
				<button
					class="menu-button relative flex border-0 rounded-full p-2 text-[1.5rem] text-gray-300 shadow-md
						bg-[image:radial-gradient(var(--gray-900),var(--gray-800)_150%)]
						aria-expanded:text-gray-0
						aria-expanded:bg-[image:linear-gradient(180deg,var(--gray-600),transparent),radial-gradient(var(--gray-900),var(--gray-800)_150%)]
						before:absolute before:-inset-px before:-z-[1] before:content-[''] before:rounded-full before:bg-[image:var(--gradient-stroke)]
						[&[hidden]]:hidden"
					aria-expanded="false"
				>
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class={navItemsClass}>
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class={linkClass} href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class={menuFooterClass}>
			<div class={socialsClass}>
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class={socialClass}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			{alternates && <LanguageSwitcher current={lang} hrefs={alternates} />}
		</div>
	</noscript>
	<div id="menu-content" class="lg:contents" hidden>
		<ul class={navItemsClass}>
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class={linkClass} href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class={menuFooterClass}>
			<div class={socialsClass}>
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class={socialClass}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			{alternates && <LanguageSwitcher current={lang} hrefs={alternates} />}
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add positioning classes in JS to avoid covering content in non-JS browsers.
			menu.classList.add('absolute', 'inset-x-0');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden === true));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>
