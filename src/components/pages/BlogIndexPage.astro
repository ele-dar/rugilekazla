---
import { getCollection } from 'astro:content';
import type { Locale } from '~/i18n/ui';
import { alternateUrls, entriesForLocale, localizedPostPath, slugify, useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = entriesForLocale(await getCollection('blog'), lang).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title={t('blog.title')}
	description={t('blog.description')}
	lang={lang}
	alternates={alternateUrls('blog')}
>
	<div class="wrapper stack gap-10">
		<h1>{t('blog.heading')}</h1>

		<ul class="posts">
			{
				posts.map((post) => (
					<li>
						<a href={localizedPostPath('blog', lang, slugify(post.data.title))}>
							<h2>{post.data.title}</h2>
						</a>
						<p class="date">
							{post.data.publishDate.toLocaleDateString(lang, {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</p>
						<p>{post.data.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.posts {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		list-style: none;
		padding: 0;
	}

	.posts h2 {
		font-size: var(--text-xl);
	}

	.date {
		color: var(--gray-300);
		font-size: var(--text-sm);
	}
</style>
