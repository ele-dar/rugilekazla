---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { type Locale } from "~/i18n/ui";
import {
  entriesForLocale,
  localizedPath,
  localizedPostPath,
  slugify,
  useTranslations,
  withBase,
} from "~/i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import NavLink from "./NavLink.astro";
import SocialLinks from "./SocialLinks.astro";
import logo from "~/assets/logo.jpeg";

interface Props {
  /** Locale of the page this nav is rendered on. */
  lang: Locale;
  /** This page's URL in every locale. */
  alternates?: Record<Locale, string> | undefined;
}

interface NavLink {
  label: string;
  href: string;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

/** Home lives at '/' for the default locale and '/en/' for English — see HomePage.astro. */
const homeHrefs = { lt: withBase("/"), en: withBase("/en/") } satisfies Record<
  Locale,
  string
>;

/** Each service gets a submenu entry under Psychotherapy, in the order set in the CMS. */
const services = entriesForLocale(await getCollection("psychotherapy"), lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((service) => ({
    label: service.data.title,
    href: localizedPostPath("psychotherapy", lang, slugify(service.data.title)),
  }));

/** Main menu items. A `children` list renders as a dropdown from that item. */
const textLinks: (NavLink & { children?: NavLink[] })[] = [
  { label: t("nav.home"), href: homeHrefs[lang] },
  {
    label: t("nav.psychotherapy"),
    href: localizedPath("psychotherapy", lang),
    children: services,
  },
  { label: t("nav.about"), href: localizedPath("about", lang) },
  { label: t("nav.articles"), href: localizedPath("articles", lang) },
  { label: t("nav.creativeWork"), href: localizedPath("creativeWork", lang) },
  { label: t("nav.trainings"), href: localizedPath("trainings", lang) },
  { label: t("nav.contacts"), href: localizedPath("contacts", lang) },
];

/** Test if a link is pointing to the current page. */
const pathname = Astro.url.pathname.replace(/\/?$/, "/");
// Home's hrefs ('/', '/en/') are prefixes of every other page in their locale, so they
// only ever match exactly — otherwise Home would show as "current" on every page.
const isCurrentPage = (href: string) =>
  Object.values(homeHrefs).includes(href)
    ? pathname === href
    : pathname.startsWith(href);

const menuFooterClass =
  "menu-footer [--icon-size:1.5rem] [--icon-padding:0.5rem] flex items-center gap-2 ";

/** One 1px bar of the hamburger icon; morphs into an X via `group-aria-expanded:*` on the button. */
const hamburgerBarClass =
  "block h-0.5 w-6 bg-gray-300 transition " +
  "group-hover:bg-green-800 group-active:bg-green-500";
---

<nav
  class="relative flex items-center justify-between bg-green-200 px-6 py-4 font-medium xl:px-24"
>
  <!-- Desktop menu left -->
  <div class="flex items-center gap-4">
    <a href={homeHrefs[lang]}>
      <Image
        src={logo}
        alt={t("site.title")}
        width={64}
        height={64}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="block h-16 w-16 rounded-full object-cover"
      />
    </a>

    <ul class="m-0 hidden list-none items-center gap-4 xl:flex">
      {
        textLinks.map(({ label, href, children }) => (
          <li class="group relative">
            <NavLink href={href} current={isCurrentPage(href)} variant="bar">
              {label}
              {children && children.length > 0 && (
                <svg
                  class="ml-1 inline-block align-middle transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              )}
            </NavLink>

            {/* Opens on hover and on keyboard focus */}
            {children && children.length > 0 && (
              <div class="invisible absolute top-full left-0 z-50 w-max min-w-full pt-2 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="m-0 flex w-full list-none flex-col gap-1 rounded-2xl bg-green-200 p-2 shadow-md">
                  {children.map((child) => (
                    <li>
                      <NavLink
                        href={child.href}
                        current={isCurrentPage(child.href)}
                        variant="dropdown"
                      >
                        {child.label}
                      </NavLink>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Desktop menu right -->
  <div class={`hidden xl:flex ${menuFooterClass}`}>
    <SocialLinks variant="plain" />

    {alternates && <LanguageSwitcher current={lang} hrefs={alternates} />}
  </div>

  <button
    id="menu-toggle"
    type="button"
    class="group flex cursor-pointer flex-col gap-1.5 border-0 bg-transparent p-1 xl:hidden"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <span class="sr-only">Menu</span>
    <span
      class={`${hamburgerBarClass} group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45`}
    ></span>
    <span class={`${hamburgerBarClass} group-aria-expanded:opacity-0`}></span>
    <span
      class={`${hamburgerBarClass} group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45`}
    ></span>
  </button>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full z-50 hidden flex-col gap-1 bg-green-200 p-5 pt-0 text-right shadow-md xl:hidden"
  >
    <ul class="flex list-none flex-col gap-1 p-0">
      {
        textLinks.map(({ label, href, children }) => (
          <li>
            <NavLink href={href} current={isCurrentPage(href)} variant="sheet">
              {label}
            </NavLink>
            {children && children.length > 0 && (
              <ul class="m-0 flex list-none flex-col gap-0.5 p-0 pr-3">
                {children.map((child) => (
                  <li>
                    <NavLink
                      href={child.href}
                      current={isCurrentPage(child.href)}
                      variant="sheet-child"
                    >
                      {child.label}
                    </NavLink>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <div class={`${menuFooterClass} mt-2 ml-auto px-4 `}>
      <SocialLinks variant="plain" />

      {alternates && <LanguageSwitcher current={lang} hrefs={alternates} />}
    </div>
  </div>

  <!-- For browsers without JS. TO-DO check functionality -->
  <noscript>
    <div
      class="absolute inset-x-0 top-full z-50 flex flex-col gap-1 border-t border-gray-800 bg-green-200 p-5 xl:hidden"
    >
      <ul class="m-0 flex list-none flex-col gap-1 p-0">
        {
          textLinks.map(({ label, href, children }) => (
            <li>
              <NavLink
                href={href}
                current={isCurrentPage(href)}
                variant="sheet"
              >
                {label}
              </NavLink>
              {children && children.length > 0 && (
                <ul class="m-0 flex list-none flex-col gap-0.5 p-0 pr-3">
                  {children.map((child) => (
                    <li>
                      <NavLink
                        href={child.href}
                        current={isCurrentPage(child.href)}
                        variant="sheet-child"
                      >
                        {child.label}
                      </NavLink>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class={`${menuFooterClass} mt-2 px-4`}>
        <SocialLinks variant="plain" />

        {alternates && <LanguageSwitcher current={lang} hrefs={alternates} />}
      </div>
    </div>
  </noscript>
</nav>

<script>
  const btn = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  btn.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!expanded));
    menu.classList.toggle("hidden", expanded);
    menu.classList.toggle("flex", !expanded);
  });
</script>
