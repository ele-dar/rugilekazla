---
import type { Locale } from '~/i18n/ui';
import { alternateUrls, useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
	title={t('contacts.title')}
	description={t('contacts.description')}
	lang={lang}
	alternates={alternateUrls('contacts')}
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero title={t('contacts.heading')} tagline={t('contacts.tagline')} />
			<p class="placeholder">{t('contacts.placeholder')}</p>
		</main>
	</div>
</BaseLayout>

<style>
	.placeholder {
		max-width: 60ch;
		margin-inline: auto;
		text-align: center;
		color: var(--gray-300);
	}
</style>
