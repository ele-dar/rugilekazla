---
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
	class:list={[
		'flex gap-2 whitespace-nowrap rounded-full border px-4 py-2 text-md leading-[1.35] no-underline transition-colors duration-200 ease-in-out',
		'bg-(--pill-bg,var(--accent-regular)) border-(--pill-bg,var(--accent-regular)) text-(--pill-color,var(--accent-text-over))',
		href && [
			'hover:bg-(--pill-hover,var(--accent-dark)) hover:border-(--pill-hover,var(--accent-dark))',
			'focus-visible:bg-(--pill-hover,var(--accent-dark)) focus-visible:border-(--pill-hover,var(--accent-dark))',
		],
		className,
	]}
	href={href}
>
	<slot />
</Tag>
