---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '~/components/Footer.astro';
// Component Imports
import MainHead from '~/components/MainHead.astro';
import Nav from '~/components/Nav.astro';
import type { Locale } from '~/i18n/ui';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** Defaults to 'en' so pages not yet translated keep their current behaviour. */
	lang?: Locale | undefined;
	/** This page's URL in every locale. Providing it shows the language switcher. */
	alternates?: Record<Locale, string> | undefined;
}

const { title, description, lang = 'en', alternates } = Astro.props;
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} lang={lang} />
	</head>
	<body>
		<!-- At least a screenful tall, so that a short page (a 404, an empty section) still
			fills the viewport and the footer's `margin-top: auto` has room to push it to the
			bottom instead of leaving it stranded mid-screen. `dvh` rather than `vh`: on mobile
			it tracks the browser chrome collapsing instead of overshooting by its height. -->
		<div class="stack min-h-dvh">
			<Nav lang={lang} alternates={alternates} />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

