---
import type { CollectionEntry } from 'astro:content';
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { localizedStaticPaths, slugify } from '../../../i18n/utils';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	// URL slug comes from this locale's own title, not the CMS filename.
	return localizedStaticPaths('blog', 'lt', (entry) => slugify(entry.data.title));
}

const { entry } = Astro.props;
---

<BlogPostPage lang="lt" post={entry} />
