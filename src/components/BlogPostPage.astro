---
import { type CollectionEntry, render } from 'astro:content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/ui';
import { alternatePostUrls, fileSlugForLocale, localizedPath, slugify, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	lang: Locale;
	post: CollectionEntry<'blog'>;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
// The CMS filename pairs this post with its translation; the public URL slug is the
// translated title instead, so each locale gets its own slug automatically.
const alternates = await alternatePostUrls(
	'blog',
	'blog',
	fileSlugForLocale(post.id, lang),
	(entry) => slugify(entry.data.title)
);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	lang={lang}
	alternates={alternates}
>
	<div class="stack gap-15">
		<header class="wrapper stack gap-4">
			<a class="back-link" href={localizedPath('blog', lang)}>
				<Icon icon="arrow-left" /> {t('blog.backLink')}
			</a>
			<h1>{post.data.title}</h1>
			<p class="date">
				{post.data.publishDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
			</p>
			{
				post.data.tags.length > 0 && (
					<ul class="tags">
						{post.data.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		<main class="wrapper">
			<div class="content">
				<Content />
			</div>
		</main>
	</div>
</BaseLayout>

<style>
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus {
		text-decoration-color: currentColor;
	}

	.date {
		color: var(--gray-300);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		font-size: var(--text-sm);
	}

	.tags li {
		padding: 0.25rem 0.75rem;
		border-radius: 999rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content {
		max-width: 65ch;
		margin-inline: auto;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}
</style>
