---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
---

<div
	class:list={[
		'flex flex-col gap-5 text-center',
		{ 'lg:text-start': align === 'start' },
	]}
>
	<div class="flex flex-col gap-3 lg:gap-4">
		<h1
			class:list={[
				'mx-auto max-w-[18ch] text-3xl font-bold tracking-tight text-green-800 lg:text-4xl',
				{ 'lg:mx-0': align === 'start' },
			]}
		>
			{title}
		</h1>
		{
			tagline && (
				<p
					class:list={[
						'mx-auto max-w-[28ch] text-lg font-semibold text-gray-700 lg:text-xl',
						{ 'lg:mx-0': align === 'start' },
					]}
				>
					{tagline}
				</p>
			)
		}
	</div>
	<slot />
</div>
